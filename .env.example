# ===========================================
# MangaT API — Variables de entorno Docker
# ===========================================
# Copia este archivo como .env en la raíz del proyecto:
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)
#
# El archivo .env NO se sube a git (.gitignore).

# Contraseña del usuario SA de SQL Server (mín. 8 chars, mayúsc, minúsc, número y símbolo)
MSSQL_SA_PASSWORD=MangaT_Str0ng!Pass

# Puerto expuesto de la API en tu máquina
API_PORT=8080

# Puerto expuesto de SQL Server en tu máquina
SQLSERVER_PORT=1433

# JWT
JWT_KEY=MangaT-SuperSecretKey-ForDevelopment-Only-32chars!
JWT_ISSUER=MangaT.API
JWT_AUDIENCE=MangaT.Client
JWT_EXPIRATION_MINUTES=60

# Entorno ASP.NET Core (Development habilita Swagger)
ASPNETCORE_ENVIRONMENT=Development
